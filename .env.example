# Copy this file to `.env` and fill in your own values.
# `.env` is ignored by git: NEVER commit real secrets.

# --- Telegram --------------------------------------------------------------------
# Token given by @BotFather.
BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot (ask @userinfobot for yours).
# Any other user is silently ignored.
ALLOWED_USER_IDS=

# --- Database ----------------------------------------------------------------------
# Local SQLite file. The Docker image already defaults to the volume (/data/asistente.db),
# so this is not needed in Railway.
DATABASE_URL=sqlite+aiosqlite:///./data/asistente.db

# --- App ---------------------------------------------------------------------------
TIMEZONE=America/Argentina/Buenos_Aires
LOG_LEVEL=INFO

# --- AI interpreter (optional) -------------------------------------------------------
# OpenAI key: understands voice messages and free-form messages the rules cannot ("el
# uber de ayer eran 2500", workouts written freely). Leave empty to use rules only.
# Create the key in a dedicated project with a monthly budget limit.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Speech-to-text for voice messages (gpt-transcribe is more accurate and costs more).
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Maximum AI requests per day, text and voice (0 disables the AI).
AI_DAILY_LIMIT=100
